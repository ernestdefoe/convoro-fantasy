<div class="admin-card">
    <div class="admin-card-body">
        <h3>@lang('fantasy.admin_leagues')</h3>

        @empty($leagues)
        <p class="admin-hint">@lang('fantasy.admin_no_leagues')</p>
        @endempty

        @notempty($leagues)
        @each ($leagues as $league)
        <details class="admin-card">
            <summary class="admin-card-header">
                <span>
                    <strong>{{ $league['name'] }}</strong>
                    <span class="admin-hint">
                        @choice('fantasy.members_count', (int) ($league['franchise_count'] ?? 0))
                        &middot;
                        @if($league['status'] === 'setup')@lang('fantasy.status_setup')@endif
                        @if($league['status'] === 'drafting')@lang('fantasy.status_drafting')@endif
                        @if($league['status'] === 'active')@lang('fantasy.status_active')@endif
                        @if($league['status'] === 'complete')@lang('fantasy.status_complete')@endif
                    </span>
                </span>
            </summary>

            <div class="admin-card-body">
                <p><a href="/fantasy/{{ $league['slug'] }}">/fantasy/{{ $league['slug'] }}</a></p>

                <form method="post" action="/admin/fantasy/{{ $league['id'] }}/rescore">
                    @csrf
                    <button type="submit" class="btn btn-secondary btn-sm">@lang('fantasy.admin_rescore')</button>
                    <span class="form-hint">@lang('fantasy.admin_rescore_hint')</span>
                </form>

                <form method="post" action="/admin/fantasy/{{ $league['id'] }}/reschedule" style="margin-top:.75rem;">
                    @csrf
                    <button type="submit" class="btn btn-secondary btn-sm">@lang('fantasy.admin_reschedule')</button>
                </form>

                <form method="post" action="/admin/fantasy/{{ $league['id'] }}/adopt" style="margin-top:.75rem;">
                    @csrf
                    <label for="fan-adopt-{{ $league['id'] }}">@lang('fantasy.admin_adopt')</label>
                    <input type="text" id="fan-adopt-{{ $league['id'] }}" name="commissioner"
                           class="form-input input-sm" autocomplete="off">
                    <button type="submit" class="btn btn-secondary btn-sm">@lang('fantasy.admin_adopt')</button>
                    <span class="form-hint">@lang('fantasy.admin_adopt_hint')</span>
                </form>

                {#
                    🚨 Typing the name back is the confirmation. Every child
                    table cascades from this row and there is no undo; a button
                    one click from a list of leagues is a button that gets
                    pressed on the wrong row.
                #}
                <form method="post" action="/admin/fantasy/{{ $league['id'] }}/delete" style="margin-top:.75rem;">
                    @csrf
                    <label for="fan-del-{{ $league['id'] }}">@lang('fantasy.admin_delete')</label>
                    <input type="text" id="fan-del-{{ $league['id'] }}" name="confirm_name"
                           class="form-input input-sm" autocomplete="off" placeholder="{{ $league['name'] }}">
                    <button type="submit" class="btn btn-danger btn-sm">@lang('fantasy.admin_delete')</button>
                    <span class="form-hint">@lang('fantasy.admin_delete_hint')</span>
                </form>
            </div>
        </details>
        @endeach
        @endnotempty
    </div>
</div>
