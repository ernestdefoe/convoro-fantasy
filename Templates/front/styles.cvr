{#
    Fantasy's styling.

    🚨 Included by Fantasy's own templates rather than pushed into every page's
    head. A stylesheet an extension adds site-wide is a stylesheet that has to be
    correct on pages it has never seen.

    🚨 Every colour is a core token with a fallback. Hard-coding one would look
    right in the theme it was written against and wrong in every other, and a
    league page is exactly the sort of thing a community re-skins.
#}
<style>
.fan-meta { color: var(--text-muted, #6b7280); font-size: .875rem; }

.fan-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }

.fan-league-card { display: flex; flex-direction: column; gap: .5rem; }
.fan-league-card h3 { margin: 0; font-size: 1.05rem; }
.fan-league-card .fan-desc { color: var(--text-muted, #6b7280); font-size: .875rem; margin: 0; }

.fan-pill {
    display: inline-flex; align-items: center; gap: .35rem;
    font-size: .75rem; font-weight: 600; letter-spacing: .01em;
    padding: .15rem .5rem; border-radius: 999px;
    background: var(--c-surface-sunken, #f3f4f6); color: var(--text-muted, #6b7280);
}
.fan-pill-live { background: var(--c-primary, #2563eb); color: #fff; }
.fan-pill-done { background: var(--c-surface-sunken, #f3f4f6); }

.fan-table { width: 100%; border-collapse: collapse; }
.fan-table th, .fan-table td { padding: .5rem .6rem; text-align: left; }
.fan-table thead th {
    font-size: .75rem; text-transform: uppercase; letter-spacing: .04em;
    color: var(--text-muted, #6b7280); border-bottom: 1px solid var(--c-border, #e5e7eb);
}
.fan-table tbody tr + tr td { border-top: 1px solid var(--c-border, #e5e7eb); }
.fan-table .fan-num { text-align: right; font-variant-numeric: tabular-nums; }

/* The crest, on the team's own colour so it reads in either theme. */
.fan-mark {
    width: 1.6rem; height: 1.6rem; flex: 0 0 auto;
    border-radius: 50%; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--c-surface-sunken, #f3f4f6);
}
.fan-mark img { width: 74%; height: 74%; object-fit: contain; }

.fan-team { display: flex; align-items: center; gap: .5rem; min-width: 0; }
.fan-team-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.fan-matchups { display: flex; flex-direction: column; gap: .6rem; }
.fan-matchup {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .75rem;
    padding: .7rem .9rem; border: 1px solid var(--c-border, #e5e7eb); border-radius: .6rem;
}
.fan-matchup .fan-side { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
.fan-matchup .fan-side-away { text-align: right; align-items: flex-end; }
.fan-matchup .fan-score { font-size: 1.15rem; font-weight: 700; font-variant-numeric: tabular-nums; }
.fan-matchup .fan-vs { color: var(--text-muted, #6b7280); font-size: .8rem; }
.fan-matchup-bye { grid-template-columns: 1fr auto; }

.fan-lineup { display: flex; flex-direction: column; gap: .5rem; }
.fan-row {
    display: flex; align-items: center; gap: .75rem; flex-wrap: wrap;
    padding: .6rem .8rem; border: 1px solid var(--c-border, #e5e7eb); border-radius: .6rem;
}
.fan-row-starting { border-color: var(--c-primary, #2563eb); }
.fan-row .fan-row-main { display: flex; align-items: center; gap: .6rem; flex: 1 1 12rem; min-width: 0; }
.fan-row .fan-mark { width: 2rem; height: 2rem; }
.fan-row .fan-row-note { color: var(--text-muted, #6b7280); font-size: .8rem; }
.fan-row form { margin: 0; }

.fan-section { margin-top: 1.75rem; }
.fan-section > h3 { margin: 0 0 .6rem; font-size: 1rem; }

.fan-board { overflow-x: auto; }
.fan-board table { min-width: 100%; }
.fan-slot { display: flex; flex-direction: column; gap: .1rem; }
.fan-slot-empty { color: var(--text-muted, #6b7280); }
.fan-slot-owner { font-size: .7rem; color: var(--text-muted, #6b7280); }

.fan-clock {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding: .9rem 1.1rem; border-radius: .6rem;
    background: var(--c-surface-sunken, #f3f4f6); margin-bottom: 1rem;
}
.fan-clock-mine { background: var(--c-primary, #2563eb); color: #fff; }
.fan-clock-mine .fan-meta { color: rgba(255, 255, 255, .8); }

.fan-moves { display: flex; flex-direction: column; gap: .4rem; font-size: .875rem; }
.fan-move { display: flex; align-items: center; gap: .5rem; }

.fan-empty { color: var(--text-muted, #6b7280); }
</style>
