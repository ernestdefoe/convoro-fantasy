{#
    🚨 The line that keeps this page honest.

    Everything below is what the scheduled scoring pass last wrote, not what is
    true this second. Saying when that was, before anything claims to be a
    result, is the difference between a page that is a few minutes behind and a
    page that lies.
#}
@if($scoredAt > 0 && $league['status'] === 'active')
<p class="fan-meta">@lang('fantasy.as_of', ['when' => \Convoro\Extensions\Picks\Picks::ago($scoredAt)])</p>
@endif

