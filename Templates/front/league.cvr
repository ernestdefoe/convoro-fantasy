{# ------------------------------------------------------------ matchups --- #}

@notempty($week)
<div class="fan-section">
    <h3>@lang('fantasy.this_week') &mdash; {{ $week['name'] }}</h3>

    @empty($matchups)
    <p class="fan-empty">@lang('fantasy.no_matchups')</p>
    @endempty

    @notempty($matchups)
    <div class="fan-matchups">
        @each ($matchups as $matchup)
        <div class="fan-matchup @if($matchup['is_bye'])fan-matchup-bye @endif">
            <div class="fan-side">
                <a href="/fantasy/{{ $league['slug'] }}/franchise/{{ $matchup['home']['id'] ?? 0 }}">
                    {{ $matchup['home']['display_name'] ?? '' }}
                </a>
                <span class="fan-score">{{ number_format($matchup['home_points'], 2) }}</span>
            </div>

            @if($matchup['is_bye'])
            <span class="fan-pill">@lang('fantasy.bye_week')</span>
            @endif

            @if(!$matchup['is_bye'])
            <span class="fan-vs">&ndash;</span>

            <div class="fan-side fan-side-away">
                <a href="/fantasy/{{ $league['slug'] }}/franchise/{{ $matchup['away']['id'] ?? 0 }}">
                    {{ $matchup['away']['display_name'] ?? '' }}
                </a>
                <span class="fan-score">{{ number_format($matchup['away_points'], 2) }}</span>
            </div>
            @endif
        </div>
        @endeach
    </div>
    @endnotempty
</div>
@endnotempty

{# ----------------------------------------------------------- standings --- #}

<div class="fan-section">
    <h3>@lang('fantasy.standings')</h3>

    @empty($standings)
    <p class="fan-empty">@lang('fantasy.lobby_empty')</p>
    @endempty

    @notempty($standings)
    <div class="card">
        <div class="card-body" style="overflow-x:auto;">
            <table class="fan-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@lang('fantasy.franchise')</th>
                        <th class="fan-num">@lang('fantasy.wins')</th>
                        <th class="fan-num">@lang('fantasy.losses')</th>
                        <th class="fan-num">@lang('fantasy.ties')</th>
                        <th class="fan-num">@lang('fantasy.points_for')</th>
                        <th class="fan-num">@lang('fantasy.points_against')</th>
                    </tr>
                </thead>
                <tbody>
                    @each ($standings as $row)
                    <tr>
                        <td>{{ $row['rank'] }}</td>
                        <td>
                            <a href="/fantasy/{{ $league['slug'] }}/franchise/{{ $row['id'] }}">{{ $row['display_name'] }}</a>
                        </td>
                        <td class="fan-num">{{ $row['wins'] }}</td>
                        <td class="fan-num">{{ $row['losses'] }}</td>
                        <td class="fan-num">{{ $row['ties'] }}</td>
                        <td class="fan-num">{{ number_format($row['points_for'], 2) }}</td>
                        <td class="fan-num">{{ number_format($row['points_against'], 2) }}</td>
                    </tr>
                    @endeach
                </tbody>
            </table>
        </div>
    </div>
    @endnotempty
</div>

{# --------------------------------------------------------------- moves --- #}

<div class="fan-section">
    <h3>@lang('fantasy.recent_moves')</h3>

    @empty($moves)
    <p class="fan-empty">@lang('fantasy.no_moves')</p>
    @endempty

    @notempty($moves)
    <div class="card">
        <div class="card-body">
            <div class="fan-moves">
                @each ($moves as $move)
                <div class="fan-move">
                    <span class="fan-mark">
                        @notempty($move['logo_path'])<img src="{{ $move['logo_path'] }}" alt="" loading="lazy">@endnotempty
                    </span>
                    <span>
                        <strong>{{ $move['franchise_name'] ?: $move['username'] }}</strong>
                        @if($move['kind'] === 'draft')@lang('fantasy.move_draft', ['team' => $move['team_name'] ?? ''])@endif
                        @if($move['kind'] === 'add')@lang('fantasy.move_add', ['team' => $move['team_name'] ?? ''])@endif
                        @if($move['kind'] === 'drop')@lang('fantasy.move_drop', ['team' => $move['team_name'] ?? ''])@endif
                    </span>
                    <span class="fan-meta">{{ \Convoro\Extensions\Picks\Picks::ago((int) $move['created_at']) }}</span>
                </div>
                @endeach
            </div>
        </div>
    </div>
    @endnotempty
</div>

