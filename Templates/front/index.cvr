@empty($leagues)
<div class="card">
    <div class="card-body">
        <p class="fan-empty">@lang('fantasy.lobby_empty')</p>
        @if($mayCreate)<p class="fan-empty">@lang('fantasy.lobby_empty_hint')</p>@endif
    </div>
</div>
